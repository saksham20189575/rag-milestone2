# Groq LLM (https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# qwen/qwen3-32b is not on Groq; use qwen/qwen3.6-27b for classifier / fast calls
GROQ_MODEL_FAST=qwen/qwen3.6-27b
GROQ_MAX_TOKENS=256
GROQ_GENERATION_MAX_TOKENS=128
GROQ_TEMPERATURE=0.1

# openai/gpt-oss-120b rate limits (https://console.groq.com)
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
GROQ_RATE_LIMIT_MAX_WAIT=65

# Local embeddings (not Groq)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store persistence
CHROMA_PERSIST_DIR=data/index
